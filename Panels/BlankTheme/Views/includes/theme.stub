{{-- Landing panel overrides --}}
<style>
    .px-spinner {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        border: 4px solid rgba(13, 110, 253, .2);
        border-top-color: #0d6efd;
        animation: px-spin .8s linear infinite;
    }
    .px-spinner-sm { width: 28px; height: 28px; border-width: 3px; }
    @keyframes px-spin { to { transform: rotate(360deg); } }
</style>
