{{-- Landing panel overrides --}}
<style>
    .px-spinner {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        border: 4px solid rgba(13, 110, 253, .2);
        border-top-color: #0d6efd;
        animation: px-spin .8s linear infinite;
    }
    .px-spinner-sm { width: 28px; height: 28px; border-width: 3px; }
    @keyframes px-spin { to { transform: rotate(360deg); } }
    .tool-box:not(:has(> *)) { display: none !important; }
    .px-form-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); column-gap: 20px; align-content: start; }
    .px-form-grid > .form-group:has(textarea), .px-form-grid > .text-end, .px-form-grid > :not(.form-group) { grid-column: 1 / -1; }
</style>
